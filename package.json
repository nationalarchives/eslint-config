{
  "name": "@nationalarchives/eslint-config",
  "version": "0.1.4",
  "description": "A global ESLint config for The National Archives",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "scripts": {
    "test": "node test.js",
    "self:test": "eslint '{index,eslint.config,test}.{mjs,js}' --config index.mjs",
    "self:fix": "eslint '{index,eslint.config,test}.{mjs,js}' --config index.mjs --fix",
    "prettier": "npx prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nationalarchives/eslint-config.git"
  },
  "author": {
    "name": "Andrew Hosgood",
    "email": "andrew.hosgood@nationalarchives.gov.uk",
    "url": "https://andrewhosgood.dev"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "bugs": {
    "url": "https://github.com/nationalarchives/eslint-config/issues"
  },
  "homepage": "https://github.com/nationalarchives/eslint-config#readme",
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.0.0"
  }
}
